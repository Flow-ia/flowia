# ─── Serveur ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── PostgreSQL (fourni automatiquement par Render) ───────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=remplacer_par_une_chaine_aleatoire_de_64_caracteres
JWT_EXPIRES_IN=7d

# ─── Brevo (envoi emails transactionnels) ─────────────────────────────────────
BREVO_API_KEY=xkeysib_xxx
SENDER_NAME=FlowIA
SENDER_EMAIL=contact@flowiapro.com
BREVO_FROM=contact@flowiapro.com

# ─── Gmail SMTP (fallback historique, plus utilise si Brevo configure) ────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton@gmail.com
SMTP_PASS=mot_de_passe_application_gmail
SMTP_FROM=FlowIA <ton@gmail.com>

# ─── CORS / URLs publiques ────────────────────────────────────────────────────
# FRONTEND_URL accepte une liste CSV pour le CORS. Le 1er domaine non-technique
# (pas www./commercant./admin.) est utilise comme racine pour les liens emails.
# Inclure tous les domaines servis par l'app (custom domains commercants compris).
FRONTEND_URL=https://flowiapro.com,https://www.flowiapro.com,https://haircoifflille.fr
# PUBLIC_BOOKING_ORIGIN : domaine racine officiel pour les liens dans les emails.
# Recommande de le definir explicitement pour eviter toute ambiguite avec FRONTEND_URL.
PUBLIC_BOOKING_ORIGIN=https://flowiapro.com

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=FlowIA

# ─── Cloudinary (images logo/couverture) ─────────────────────────────────────
MEDIA_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=ton_cloud_name
CLOUDINARY_API_KEY=ton_api_key
CLOUDINARY_API_SECRET=ton_api_secret

# ─── Web Push VAPID ───────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:ton@email.com

# ─── Pool PostgreSQL ──────────────────────────────────────────────────────────
DB_POOL_MAX=25
DB_POOL_MIN=2
WEB_CONCURRENCY=1

# ─── Stripe (recharge SMS commerçant — compte plateforme FlowIA) ──────────────
# Clé secrète du compte plateforme FlowIA (sk_live_xxx ou sk_test_xxx)
STRIPE_SECRET_KEY=sk_test_xxx
# Webhook signature pour /api/payments/sms/webhook (recharge SMS)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ─── Stripe Connect Standard (paiements en ligne réservations) ────────────────
# Pattern Setmore : chaque commerçant connecte son compte Stripe via OAuth.
# Les fonds vont DIRECTEMENT au commerçant ; FlowIA peut prélever une
# application_fee configurable par commerçant (commission_rate en DB, 0 % par défaut).
#
# 1. CLIENT_ID — récupéré dans Stripe Dashboard > Settings > Connect > Settings
#    (commence par ca_xxx). Identifie FlowIA comme plateforme dans le flow OAuth.
STRIPE_CONNECT_CLIENT_ID=ca_xxx
#
# 2. WEBHOOK_SECRET — webhook DÉDIÉ aux events Connect (account.updated,
#    payment_intent.succeeded, charge.refunded sur comptes connectés).
#    À configurer comme webhook séparé dans Stripe Dashboard pointant vers
#    /api/stripe-connect/webhook avec "Listen to events on Connected accounts" coché.
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_xxx
# Dual-mode (Test + Live) : memes principes que pour subscription. Le code
# essaie les 2 secrets jusqu'a en trouver un qui valide. Permet de tester
# en mode Test sans switcher la prod en Live.
STRIPE_CONNECT_WEBHOOK_SECRET_TEST=whsec_xxx
STRIPE_CONNECT_WEBHOOK_SECRET_LIVE=whsec_xxx
# 2eme webhook Connect — events sur les COMPTES CONNECTES (paiements
# RDV recus par les marchands : payment_intent.succeeded/failed,
# charge.refunded). Stripe ne permet pas de mixer 'Votre compte' et
# 'Comptes connectes' sur le meme webhook -> 2 webhooks distincts.
# Meme URL endpoint (/api/stripe-connect/webhook), 2 secrets distincts,
# le code essaie les 4 jusqu'a en trouver un qui valide.
STRIPE_CONNECT_CONNECTED_WEBHOOK_SECRET_TEST=whsec_xxx
STRIPE_CONNECT_CONNECTED_WEBHOOK_SECRET_LIVE=whsec_xxx
#
# Note : la redirect URI OAuth est dérivée automatiquement de FRONTEND_URL
# (premier domaine) → /reglages/reservations/configuration?stripe_oauth=callback.
# Elle doit être ajoutée dans Stripe Dashboard > Connect > Settings > Redirects.

# ─── Stripe Subscriptions (abonnement plateforme FlowIA) ──────────────────────
# Plans Découverte (gratuit, sans Stripe) / Essentiel (24€/mois ou 240€/an) /
# Équipe (49€/mois ou 490€/an). Géré via stripe.subscriptions sur le compte
# plateforme — SÉPARÉ de Connect (qui gère paiements clients->commerçants).
#
# Les 4 IDs (mensuel + annuel par plan) sont récupérés depuis Stripe Dashboard
# → Products → cliquer sur chaque tarif → "Copier l'ID du tarif".
# IDs Test pour dev local, IDs Live pour Render production (univers Stripe
# séparés, IDs forcément différents).
STRIPE_PRICE_ESSENTIEL_MONTHLY=price_xxx
STRIPE_PRICE_ESSENTIEL_YEARLY=price_xxx
STRIPE_PRICE_EQUIPE_MONTHLY=price_xxx
STRIPE_PRICE_EQUIPE_YEARLY=price_xxx
#
# Webhook DÉDIÉ aux events abonnement (customer.subscription.*, invoice.paid,
# invoice.payment_failed). Endpoint /api/subscriptions/webhook — séparé du
# webhook SMS existant pour ne pas casser l'idempotence SMS.
#
# DEUX secrets : Test ET Live. Les deux pointent vers le même endpoint Render
# mais signent avec des clés différentes. Backend détecte event.livemode et
# vérifie avec le bon secret. Permet de tester en mode Test sans casser la prod.
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET_TEST=whsec_xxx
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET_LIVE=whsec_xxx
